      [36, 0, 1, 2, 3, 4, 5, 6, 7, 10, 11], // 평택 지제역 한화
      [38, 7], // 오산서동 우미건설
      [46, 5, 10], // 수지 자이 에디시온
      [51, 10], // 포곡 한림제약 녹십자
      [56, 3, 5, 10] // 의왕 고천 나구역 sk건설
    ],
    "소형": [
      [9, 10] // 수영 로지콘
    ]
  },
  "updated": "2026-09-17"
};

const sheetNames = Object.keys(DATA.sheets);
let sheet = sheetNames[0];
let branch = '전체';
const branchOrder = ['전체', '중부', '남부', '남서', '북부', '북서', '서부', '동부', '용인'];
let q = '';

function esc(x) {
  return String(x ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function short(x, n = 95) {
  x = String(x ?? '').replace(/\s+/g, ' ').trim();
  return x.length > n ? x.slice(0, n) + '…' : x;
}

function nums(r) {
  let a = [];
  if (r['총대수']) a.push('총 ' + r['총대수']);
  if (r['배정대수']) a.push('배정 ' + r['배정대수']);
  if (r['설치대수']) a.push('설치 ' + r['설치대수']);
  return a.join(' · ');
}

function isChanged(sheetName, index, col) {
  const marks = DATA.changed?.[sheetName] || [];
  return marks.some(m => m[0] === index && (m[1] === undefined || m.slice(1).includes(col)));
}

function mark(v, s, i, c) {
  return isChanged(s, i, c) ? '<span class="changed">' + esc(v) + '</span>' : esc(v);
}

function renderTabs() {
  document.getElementById('tabs').innerHTML = sheetNames.map(s => 
    `<button class="tab ${s === sheet ? 'active' : ''}" onclick="setSheet('${s}')">${s === '현장별교섭현황' ? '대형' : s}</button>`
  ).join('');
}

function renderBranches() {
  document.getElementById('subtabs').innerHTML = branchOrder.map(b => 
    `<button class="tab ${b === branch ? 'active' : ''}" onclick="setBranch('${b}')">${b}</button>`
  ).join('');
}

function renderRentals() {
  const section = document.getElementById('rentals-section');
  if (!DATA.rentals || DATA.rentals.length === 0) {
    section.style.display = 'none';
    return;
  }
  section.style.display = 'block';
  section.innerHTML = `<h2>임대사별 약속사항</h2>` + DATA.rentals.map(r => `
    <div class="rrow">
      <b>${esc(r.임대사)}</b>
      <span>${esc(r.약속사항)}</span>
    </div>
  `).join('');
}

function render() {
  renderTabs();
  renderBranches();
  const searchInput = document.getElementById('search');
  const clearBtn = document.getElementById('clear-btn');
  clearBtn.style.display = searchInput.value ? 'block' : 'none';

  let arr = DATA.sheets[sheet] || [];
  let filtered = arr.filter((r) => {
    let text = Object.values(r).join(' ').toLowerCase();
    return (branch === '전체' || r['구분'] === branch) && (!q || text.includes(q.toLowerCase()));
  });

  document.getElementById('count').textContent = `${sheet === '현장별교섭현황' ? '대형현장' : '소형현장'} · ${filtered.length}개 현장 (업데이트: ${DATA.updated || '-'})`;

  const listEl = document.getElementById('list');
  listEl.innerHTML = filtered.length ? filtered.map((r, idx) => card(r, arr.indexOf(r), idx + 1)).join('') : '<div class="empty">조건에 맞는 현장이 없습니다.</div>';
  renderRentals();
}

function card(r, i, seq) {
  let detail = [
    r['현장주소'] ? `주소: ${mark(r['현장주소'], sheet, i, 11)}` : '',
    r['현장사항'] ? `현장사항: ${esc(r['현장사항'])}` : '',
    r['현장제원'] ? `현장제원: ${esc(r['현장제원'])}` : ''
  ].filter(Boolean).join('<br>');

  return `<article class="card" onclick="this.classList.toggle('open')">
    <div class="top">
      <div class="branch">
        <span class="idx">No.${seq}</span>
        <span>${mark(r['구분'] || '-', sheet, i, 0)}</span>
      </div>
      <div class="main">
        <div class="name">${mark(r['현장명'], sheet, i, 2)}</div>
        <div class="meta">${r['임대사'] ? mark('임대사 · ' + r['임대사'], sheet, i, 3) : '임대사 미정'}${r['현장제원'] ? ' · ' + esc(r['현장제원']) : ''}</div>
      </div>
      <div class="right">
        ${r['설치예정'] ? '<div class="install">' + mark(r['설치예정'], sheet, i, 5) + '</div>' : ''}
        <div class="numbers">${mark(nums(r), sheet, i, 7)}</div>
      </div>
    </div>
    <div class="body">
      ${r['교섭및쟁의사항'] ? '<div class="neg">' + mark(short(r['교섭및쟁의사항']), sheet, i, 10) + '</div>' : '<div class="neg" style="color:#718097">교섭내용 없음</div>'}
      <div class="extra">
        ${r['현설예정'] ? '<span class="chip">현설 ' + mark(r['현설예정'], sheet, i, 4) + '</span>' : ''}
        ${r['현장사항'] ? '<span class="chip">' + mark(r['현장사항'], sheet, i, 6) + '</span>' : ''}
      </div>
      ${detail ? '<div class="details">' + detail + '</div><div class="more">카드 터치 → 상세보기</div>' : ''}
    </div>
  </article>`;
}

function setSheet(s) {
  sheet = s;
  branch = '전체';
  render();
}

function setBranch(b) {
  branch = b;
  render();
}

const searchInput = document.getElementById('search');
searchInput.addEventListener('input', e => {
  q = e.target.value;
  render();
});

document.getElementById('clear-btn').addEventListener('click', () => {
  searchInput.value = '';
  q = '';
  render();
});

render();
</script>
</body>
</html>
