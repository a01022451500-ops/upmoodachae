    {"연번": 15, "임대사": "필웍스", "약속사항": "이번 현장 40프로 진행안될시 추후 현장 50% 받고 인원비례 대수추진"}
  ],
  "changed": {
    "현장별교섭현황": [
      [3, 3, 5, 7, 10], // 계성건설
      [7, 0, 1, 2, 3, 5, 7, 10], // (주)우건
      [16, 5, 7, 10], // 동탄1 계룡
      [17, 5, 7, 10], // 북오산 내삼미1 GS
      [18, 5, 10], // 북오산 내삼미2 GS
