    ]
  },
  "rentals": [
    {"연번": 1, "임대사": "규람타워", "약속사항": "40%"},
    {"연번": 2, "임대사": "성광", "약속사항": "40~50%"},
    {"연번": 3, "임대사": "BMK", "약속사항": "40% + 과천태왕건으로 1대 추가"},
    {"연번": 4, "임대사": "예림", "약속사항": "40%"},
    {"연번": 5, "임대사": "중앙", "약속사항": "40% + 1대 추가"},
    {"연번": 6, "임대사": "한성프라임", "약속사항": "다음 현장 50%, 그 이후 현장은 인원비례로 결정"},
    {"연번": 7, "임대사": "우정타워", "약속사항": "차후 40% 배정 예정"},
    {"연번": 8, "임대사": "동양타워", "약속사항": "차후 40% 배정 예정"},
    {"연번": 9, "임대사": "삼진", "약속사항": "40% + 1대 추가 배정"},
    {"연번": 10, "임대사": "제일타워공영", "약속사항": "다음 현장 50%"},
    {"연번": 11, "임대사": "뉴월드타워", "약속사항": "다음 현장 40%"},
    {"연번": 12, "임대사": "신화중공업", "약속사항": "인원대비 적정수준 배정 인정 (예: 40% 추진)"},
